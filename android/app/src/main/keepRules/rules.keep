# Правила R8 для приложения. AGP объединяет все файлы в src/main/keepRules.

# Go-ядро (shron.aar, gomobile). libgojni.so находит классы, методы и поля через JNI по
# именам, поэтому R8 не должен их удалять, переименовывать или менять сигнатуры.
-keep class go.** { *; }
-keep class io.github.f3dosik.shron.mobile.** { *; }

# Реализации LockListener вызываются из Go по имени метода onLock.
-keepclassmembers class * implements io.github.f3dosik.shron.mobile.LockListener {
    public void onLock(java.lang.String);
}
