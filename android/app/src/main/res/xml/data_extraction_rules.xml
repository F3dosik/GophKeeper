<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ переносит данные при смене устройства даже при allowBackup="false",
     поэтому файлы приложения исключаются и из облачной копии, и из переноса. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
