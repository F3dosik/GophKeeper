# Database
POSTGRES_USER=gophkeeper       # имя пользователя postgres
POSTGRES_PASSWORD=6e2fb4e28ca5225a7bfe    # пароль postgres
POSTGRES_DB=gophkeeper         # название базы данных
DATABASE_URL=postgresql://gophkeeper:6e2fb4e28ca5225a7bfe@db/gophkeeper?sslmode=disable         # полная строка подключения

# Auth
JWT_SECRET=a6f25d81266318c13c03579d083e4993f45aff9fb69bef706bf0f853b01fb88f           # секрет для подписи JWT, минимум 32 символа
TOKEN_TTL=24h         # время жизни JWT (например, 1h, 30m, 24h)

# Server
SERVER_PORT=50051         # порт сервера
LOG_LEVEL=production            # development или production

# TLS (обязательно, если сервер доступен по сети). Сертификаты: make certs CERT_HOSTS=...
# Пути указываются внутри контейнера (каталог ./certs монтируется в /certs).
# Если оба пусты, сервер работает без TLS — только для локальной разработки.
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key
