# Database
POSTGRES_USER=        # имя пользователя postgres
POSTGRES_PASSWORD=    # пароль postgres
POSTGRES_DB=          # название базы данных
DATABASE_URL=         # полная строка подключения

# Auth
JWT_SECRET=           # секрет для подписи JWT, минимум 32 символа
TOKEN_TTL=1h          # время жизни JWT (например, 30m, 1h); клиент обновляет токен при каждой операции

# Limits (необязательно, ниже значения по умолчанию)
AUTH_RATE_LIMIT=30        # запросов к GetSalt/CreateUser/Login в минуту с одного IP
AUTH_RATE_BURST=20        # таких запросов подряд с одного IP
SECRET_MAX_SIZE=1048576   # максимальный размер зашифрованного секрета, байт
SECRET_MAX_COUNT=1000     # максимум секретов у одного пользователя

# Registration
REGISTRATION_ENABLED=true # false — регистрация только через административный порт
ADMIN_PORT=50052          # административный порт (только число); пусто — не запускать
TEMP_PASSWORD_TTL=24h     # срок действия временного пароля (auth register --temporary)

# Server
SERVER_PORT=50051         # порт сервера
LOG_LEVEL=            # development или production

# TLS (обязательно, если сервер доступен по сети). Сертификаты: make certs CERT_HOSTS=...
# Пути указываются внутри контейнера (каталог ./certs монтируется в /certs).
# Если оба пусты, сервер работает без TLS — только для локальной разработки.
TLS_CERT_FILE=/certs/server.crt
TLS_KEY_FILE=/certs/server.key

# Backups (сервис backup в docker-compose, копии в ./backups)
BACKUP_INTERVAL=24h       # как часто делать копию (30m, 6h, 24h)
BACKUP_KEEP=14            # сколько последних копий хранить
